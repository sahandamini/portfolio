{
	"name": "portfolio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev --ignore-lock",
		"resume": "sh scripts/build-resume.sh",
		"build": "sh scripts/build-resume.sh && astro build",
		"preview": "wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"check": "vp check && prettier --check \"**/*.astro\" && eslint && astro check",
		"fmt": "vp fmt && prettier --write \"**/*.astro\"",
		"test:unit": "vp test run",
		"test:visual": "playwright test --grep @visual --retries=0 --update-snapshots=none",
		"test:visual:record": "playwright test --grep @visual --retries=0 --update-snapshots=all",
		"e2e": "playwright test --grep-invert @visual",
		"report": "playwright show-report .playwright/report",
		"prepare": "vp config --hooks --no-agent && varlock codegen && wrangler types && astro sync",
		"update-pnpm": "corepack use pnpm@12",
		"dead-code": "fallow dead-code"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.3",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/geist-mono": "^5.2.7",
		"@lucide/astro": "^1.14.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "^7.4.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"posthog-js": "^1.306.1",
		"resend": "^6.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"varlock": "^1.22.0"
	},
	"devDependencies": {
		"@aamini/config": "0.2.0",
		"@astrojs/check": "^0.9.10",
		"@playwright/test": "^1.64.0",
		"@shadcn/lint": "^0.2.1",
		"@types/node": "^24.19.2",
		"@typescript-eslint/parser": "^8.71.2",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.12.0",
		"fallow": "^3.6.0",
		"oxlint-plugin-eslint": "^1.73.0",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"typescript": "^6.0.3",
		"vite-plus": "1.1.0",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
