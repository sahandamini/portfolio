---
import { FileText, Mail } from '@lucide/astro'
import Button from '@/components/ui/button.astro'

interface Props {
	mode: 'flow' | 'header'
}

const { mode } = Astro.props
---

{mode === 'header' ? (
	<div class="flex items-center gap-2">
		<Button
			variant="neon"
			href="/resume.pdf"
			rel="noopener noreferrer"
			target="_blank"
			class="group inline-flex items-center rounded-full"
		>
			<FileText class="mr-2 size-4 transition-all group-hover:-translate-y-0.5 group-hover:scale-105 group-hover:text-white" />
			<span class="relative transition-colors group-hover:text-white">
				Resume
			</span>
		</Button>
		<Button
			variant="neon"
			href="/contact"
			class="group inline-flex items-center rounded-full"
		>
			<Mail class="mr-2 size-4 transition-all group-hover:-translate-y-0.5 group-hover:scale-105 group-hover:text-white" />
			<span class="relative transition-colors group-hover:text-white">
				Contact
			</span>
		</Button>
	</div>
) : (
	<div class="border-border/70 bg-background/60 dark:bg-background/40 inline-flex items-center gap-0.5 rounded-full border px-0.5 py-0.5 shadow-xs backdrop-blur-md">
		<Button
			variant="ghost"
			href="/resume.pdf"
			rel="noopener noreferrer"
			target="_blank"
			class="group hover:bg-resume/10 inline-flex items-center rounded-full bg-transparent px-4 py-2.5 font-medium transition-all active:scale-95"
		>
			<FileText class="text-muted-foreground/90 group-hover:text-resume mr-2 size-4 transition-all group-hover:-translate-y-0.5 group-hover:scale-105" />
			<span class="text-foreground group-hover:text-resume relative transition-colors">
				Resume
			</span>
		</Button>
		<div class="bg-border/50 mx-0.5 h-4 w-px" aria-hidden="true" />
		<Button
			variant="ghost"
			href="/contact"
			class="group hover:bg-brand/10 inline-flex items-center rounded-full bg-transparent px-4 py-2.5 font-medium transition-all active:scale-95"
		>
			<Mail class="text-muted-foreground/90 group-hover:text-brand mr-2 size-4 transition-all group-hover:-translate-y-0.5 group-hover:scale-105" />
			<span class="text-foreground group-hover:text-brand relative transition-colors">
				Contact
			</span>
		</Button>
	</div>
)}
