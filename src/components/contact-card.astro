---
import { Image } from 'astro:assets'
import { Briefcase, GraduationCap, Mail, MapPin } from '@lucide/astro'
import profile from '@/assets/profile.jpg'
import BrandIcon from '@/components/brand-icon.astro'

const facts = [
	{ icon: Mail, text: 'sahandaamini@gmail.com' },
	{ icon: MapPin, text: 'Philadelphia, PA, USA' },
	{ icon: Briefcase, text: '4+ years experience' },
	{ icon: GraduationCap, text: 'BS in Computer Science' },
]
---

<div class="bg-card/50 border-border mx-auto max-w-md rounded-lg border p-6 shadow-lg backdrop-blur-sm">
	<div class="mb-6 flex flex-col items-center text-center">
		<Image
			src={profile}
			alt="Sahand Amini"
			width={96}
			height={96}
			densities={[1, 2]}
			class="mb-4 size-24 rounded-full object-cover"
		/>
		<h2 class="text-foreground text-3xl font-bold">Sahand Amini</h2>
		<p class="text-role text-lg">Software Engineer</p>
	</div>

	<div class="text-muted-foreground space-y-4 text-lg">
		{facts.map(({ icon: Icon, text }) => (
			<div class="flex items-center">
				<Icon class="text-muted-foreground mr-4 size-6" />
				<span>{text}</span>
			</div>
		))}
	</div>

	<div class="border-border text-muted-foreground mt-8 border-t pt-6">
		<h3 class="text-foreground mb-4 text-2xl font-semibold">Background</h3>
		<p class="mb-4 text-base leading-relaxed">
			Born in New Orleans and graduated from Arizona State University. I'm an
			experienced programmer with a passion for learning and improving. I
			specialize in backend development but am always eager to explore the
			latest & greatest technologies!
		</p>
		<div class="flex justify-center space-x-6">
			<a
				href="https://github.com/sahandamini"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
				class="text-muted-foreground hover:text-foreground transition-colors"
			>
				<BrandIcon name="github" class="size-8" />
			</a>
			<a
				href="https://linkedin.com/in/sahandamini"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
				class="text-muted-foreground hover:text-foreground transition-colors"
			>
				<BrandIcon name="linkedin" class="size-8" />
			</a>
		</div>
	</div>
</div>
