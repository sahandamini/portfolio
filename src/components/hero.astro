---
import SiteActions from '@/components/site-actions.astro'

const name = 'Sahand Amini'
---

<section
	id="hero-section"
	class="bg-background flex min-h-screen flex-col items-center justify-center space-y-8 p-8"
>
	<div class="text-center">
		<h1 class="text-6xl font-bold md:text-8xl">
			{[...name].map((letter, index) => (
				<span class="hero-letter" style={{ '--letter-index': index }}>
					{letter}
				</span>
			))}
			<span class="typing-cursor" aria-hidden="true"></span>
		</h1>
		<p class="mt-4 text-2xl md:text-3xl">Full Stack Engineer</p>
	</div>
	<div
		data-hero-actions
		class="pointer-events-auto mt-8 scale-100 opacity-100 transition-all duration-300 ease-out data-pinned:pointer-events-none data-pinned:scale-95 data-pinned:opacity-0"
	>
		<SiteActions mode="flow" />
	</div>
</section>
