---
import ContactCard from '@/components/contact-card.astro'
import Hero from '@/components/hero.astro'
import ScrollButtons from '@/components/scroll-buttons.astro'
import SiteActions from '@/components/site-actions.astro'
import ThemeToggle from '@/components/theme-toggle.astro'
import Timeline from '@/components/timeline.astro'
import Base from '@/layouts/base.astro'
---

<Base>
	<div class="relative">
		<div class="fixed inset-x-0 top-[calc(env(safe-area-inset-top)+14px)] z-50">
			<div class="flex items-center justify-between px-4">
				<div class="pointer-events-auto">
					<ThemeToggle />
				</div>
				<div
					data-header-actions
					class="pointer-events-none -translate-y-2 scale-95 opacity-0 transition-all duration-300 ease-out data-pinned:pointer-events-auto data-pinned:translate-y-0 data-pinned:scale-100 data-pinned:opacity-100"
				>
					<SiteActions mode="header" />
				</div>
			</div>
		</div>

		<Hero />

		<section
			id="about"
			class="bg-background relative z-20 flex min-h-screen scroll-mt-16 flex-col items-center space-y-4 px-4 pb-20 md:scroll-mt-0"
		>
			<h2 class="bg-background w-full py-4 text-center text-5xl font-bold">
				About Me
			</h2>
			<div class="flex w-full grow flex-col items-center justify-center space-y-12 md:flex-row md:space-y-0 md:space-x-8">
				<div class="flex flex-col space-y-8 md:w-1/2">
					<ContactCard />
				</div>
				<div class="flex justify-center md:w-1/2">
					<Timeline />
				</div>
			</div>
		</section>

		<ScrollButtons />
	</div>
	<script src="@/scripts/home.ts"></script>
</Base>
