---
import { Image } from 'astro:assets'
import { ArrowLeft, Mail } from '@lucide/astro'
import profile from '@/assets/profile.jpg'
import BrandIcon from '@/components/brand-icon.astro'
import ContactForm from '@/components/contact-form.astro'
import EmailSnippet from '@/components/email-snippet.astro'
import SiteActions from '@/components/site-actions.astro'
import ThemeToggle from '@/components/theme-toggle.astro'
import Button from '@/components/ui/button.astro'
import Base from '@/layouts/base.astro'

const email = 'sahandaamini@gmail.com'
---

<Base title="Contact | Sahand Amini">
	<div class="bg-background flex min-h-screen items-center justify-center p-4">
		<Button
			variant="secondary"
			href="/"
			class="border-border bg-card text-card-foreground fixed top-[calc(env(safe-area-inset-top)+80px)] left-4 z-60 size-12 cursor-pointer border shadow-md md:top-1/2 md:left-1/2 md:size-16 md:-translate-x-112 md:-translate-y-60"
			aria-label="Back to home"
		>
			<ArrowLeft />
		</Button>

		<div class="fixed inset-x-0 top-[calc(env(safe-area-inset-top)+14px)] z-50">
			<div class="flex items-center justify-between px-4">
				<div class="pointer-events-auto flex items-center gap-2">
					<ThemeToggle />
				</div>
				<div class="pointer-events-auto">
					<SiteActions mode="header" />
				</div>
			</div>
		</div>

		<main class="bg-card text-card-foreground flex w-full max-w-2xl flex-col gap-6 rounded-xl border p-8 shadow-lg">
			<div class="flex items-center justify-between">
				<h1 class="text-5xl font-bold">Get In Touch</h1>
				<Image
					src={profile}
					alt="Sahand Amini"
					width={96}
					height={96}
					densities={[1, 2]}
					class="size-24 rounded-full object-cover"
				/>
			</div>

			<div class="flex flex-wrap items-center gap-4">
				<Button
					variant="outline"
					size="lg"
					href="https://www.linkedin.com/in/sahandamini/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					class="group border-linkedin/40 text-foreground hover:bg-linkedin/5 hover:text-linkedin dark:border-linkedin/50 dark:hover:bg-linkedin/10"
				>
					<BrandIcon
						name="linkedin"
						class="group-hover:text-linkedin size-4 transition-colors"
					/>
				</Button>
				<Button
					variant="outline"
					size="lg"
					href={`mailto:${email}`}
					aria-label="Email"
					class="group border-brand/40 text-foreground hover:bg-brand/5 dark:border-brand/50 dark:hover:bg-brand/10"
				>
					<Mail class="group-hover:text-brand size-4 transition-colors" />
				</Button>
				<EmailSnippet email={email} />
			</div>

			<ContactForm />
		</main>
	</div>
</Base>
