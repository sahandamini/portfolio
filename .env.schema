# Local values live in .env.local, encrypted with `varlock encrypt`.
# The build needs no secrets, so Workers Builds sets no variables.
#
# @defaultSensitive=true @defaultRequired=infer
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none, processEnv=none)
# ---

# CI sets this to test.
# @type=enum(development, test, production) @public
APP_ENV=development

# Local dev server port.
# @type=port @public
APP_PORT=3000

# Site under test for Playwright.
# @type=url @public
BASE_URL=

# ===== Cloudflare =====
# The only account. Wrangler reads it for local deploys.
# @type=string @public
CLOUDFLARE_ACCOUNT_ID=2ffaac685003b8117534ba3ad50ba56f

# Account token for local `wrangler deploy` and DNS tooling. CI and Workers
# Builds run without it. Workers Builds accepts only user tokens.
# @docs(https://developers.cloudflare.com/fundamentals/api/get-started/account-owned-tokens/)
CLOUDFLARE_API_TOKEN=

# ===== Resend =====
# Sends contact form email. The deployed Worker reads a Worker secret, and
# `astro dev` reads .dev.vars. See docs/email.md.
# @type=string(startsWith=re_)
# @docs(https://resend.com/docs/api-reference/introduction)
RESEND_API_KEY=
